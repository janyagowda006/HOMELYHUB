# Server Configuration
PORT=8080
NODE_ENV=production

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/homelyhub?retryWrites=true&w=majority

# Mailtrap / SMTP Email Configuration
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=your_mailtrap_user
MAILTRAP_SMTP_PASS=your_mailtrap_password

# ImageKit Configuration (for Property Image Hosting)
IMAGEKIT_PUBLICKEY=your_imagekit_public_key
IMAGEKIT_PRIVATEKEY=your_imagekit_private_key
IMAGEKIT_URLENDPOINT=https://ik.imagekit.io/your_endpoint_id

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_homelyhub_2026
JWT_EXPIRES_IN=90d
JWT_COOKIES_EXPIRES_IN=90

# Groq AI SDK Key (for AI Property Description & Trip Genie)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Frontend URL (for CORS in production split deployment)
FRONTEND_URL=https://your-frontend-domain.vercel.app
